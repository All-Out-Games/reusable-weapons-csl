Piercing_Projectile :: class : Component {
    damage: float;
    lifetime: float;
    direction: v2;
    owner_user_id: string;
    speed: float;
    max_lifetime: float;
    hit_ids: [32]u64;
    hit_count: s64;
    mute_hit_sound: bool;
    weapon_type: Weapon_Type;

    ao_update :: method(dt: float) {
        lifetime += dt;
        if max_lifetime <= 0 {
            max_lifetime = 3.0;
        }
        if lifetime > max_lifetime {
            entity.destroy();
            return;
        }

        move := v2{direction.x * speed * dt, direction.y * speed * dt};
        entity.add_local_position(move);

        pos := entity.world_position + v2{0, -0.5};
        nearby: [..]Weapon_Target;
        Scene.get_all_components_in_range(pos, 0.8, ref nearby);

        for hit_target: nearby {
            if hit_target.owner_user_id == owner_user_id continue;

            // Check if already hit
            already_hit := false;
            j := 0;
            while j < hit_count {
                if hit_ids[j] == hit_target.entity.id {
                    already_hit = true;
                }
                j += 1;
            }
            if already_hit continue;

            // Record hit
            if hit_count < 32 {
                hit_ids[hit_count] = hit_target.entity.id;
                hit_count += 1;
            }

            weapon_target_apply_damage(hit_target, damage, owner_user_id);

            if !mute_hit_sound {
                hit_sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/bullet_hit.wav");
                sfx_desc := SFX.default_sfx_desc();
                sfx_desc.set_position(pos);
                sfx_desc.range_multiplier = 2.0;
                SFX.play(hit_sfx, sfx_desc);
            }
            weapon_spawn_impact_particles(pos, weapon_type, direction);
        }
    }
}
