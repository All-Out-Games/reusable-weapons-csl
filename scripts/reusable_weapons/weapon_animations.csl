WEAPON_POSE_AIM :: "weapon_pose_aim";

setup_weapon_pose_pair :: proc(
    sm: State_Machine,
    layer: State_Machine_Layer,
    normal_idle: State_Machine_State,
    normal_run: State_Machine_State,
    moving_var: State_Machine_Variable,
    pose_variable_name: string,
    idle_animation: string,
    run_animation: string,
) {
    pose_var := sm.create_variable(pose_variable_name, .BOOL);
    pose_idle := layer.create_state(idle_animation, true);
    pose_run := layer.create_state(run_animation, true);

    layer.create_transition(normal_idle, pose_idle, false).create_bool_condition(pose_var, true);
    layer.create_transition(normal_run, pose_run, false).create_bool_condition(pose_var, true);
    layer.create_transition(pose_run, pose_idle, false).create_bool_condition(moving_var, false);
    layer.create_transition(pose_idle, pose_run, false).create_bool_condition(moving_var, true);
    layer.create_transition(pose_idle, normal_idle, false).create_bool_condition(pose_var, false);
    layer.create_transition(pose_run, normal_run, false).create_bool_condition(pose_var, false);
}

setup_weapon_shoot_state :: proc(
    sm: State_Machine,
    layer: State_Machine_Layer,
    clear_state: State_Machine_State,
    animation: string,
    trigger_name: string,
) {
    trigger := sm.create_variable(trigger_name, .TRIGGER);
    shoot_state := layer.create_state(animation, false);
    layer.create_global_transition(shoot_state, true).create_trigger_condition(trigger);
    layer.create_transition(shoot_state, clear_state, true);
}

setup_reusable_weapons_player_state_machine :: proc(player: Player) {
    sm := player.animator.state_machine;
    base_layer := sm.try_get_layer("main");
    normal_idle := base_layer.try_get_state("Idle");
    normal_run := base_layer.try_get_state("Run_Fast");
    moving_var := sm.try_get_variable("moving");

    setup_weapon_pose_pair(sm, base_layer, normal_idle, normal_run, moving_var, WEAPON_POSE_AIM, "Idle_mIK", "Run_Fast_mIK");

    shoot_layer := sm.create_layer("reusable_weapon_shoot", 3);
    shoot_clear := shoot_layer.create_state("__CLEAR_TRACK__", true);
    shoot_layer.set_initial_state(shoot_clear);

    setup_weapon_shoot_state(sm, shoot_layer, shoot_clear, "Shoot_Gun_mIK_AL", "weapon_shoot");

    clear_trigger := sm.create_variable("weapon_shoot_clear", .TRIGGER);
    shoot_layer.create_global_transition(shoot_clear, false).create_trigger_condition(clear_trigger);

    melee_layer := sm.create_layer("reusable_weapon_melee", 4);
    melee_clear := melee_layer.create_state("__CLEAR_TRACK__", true);
    melee_layer.set_initial_state(melee_clear);
    setup_weapon_shoot_state(sm, melee_layer, melee_clear, "Attack_Slash_1", "weapon_melee");
}

weapon_apply_player_pose :: proc(player: Player, wt: Weapon_Type) {
    sm := player.animator.state_machine;
    sm.set_bool(WEAPON_POSE_AIM, false);

    if wt == .NONE || wt == .BOOMWHEEL return;
    sm.set_bool(WEAPON_POSE_AIM, true);
}

weapon_trigger_player_shoot_animation :: proc(player: Player, wt: Weapon_Type) {
    if wt == .NONE || wt == .BOOMWHEEL return;

    // Hold-fired weapons stay in their aiming pose. Replaying the one-shot
    // recoil each damage tick makes machine guns and beams look like throws.
    config := get_weapon_config(wt);
    if config.fire_mode == .CONTINUOUS || config.fire_mode == .BEAM return;

    player.animator.state_machine.set_trigger("weapon_shoot");
}

weapon_clear_player_shoot_animation :: proc(player: Player) {
    player.animator.state_machine.set_trigger("weapon_shoot_clear");
}

weapon_trigger_melee_animation :: proc(player: Player) {
    player.animator.state_machine.set_trigger("weapon_melee");
}
