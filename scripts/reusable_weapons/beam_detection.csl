// Line beam: damage targets along a line from origin in direction
beam_line_damage :: proc(player: Player, origin: v2, direction: v2, range: float, width: float, damage: float, wt: Weapon_Type) {
    nearby: [..]Weapon_Target;
    Scene.get_all_components_in_range(origin, range, ref nearby);

    dir := normalize(direction);

    for target: nearby {
        if target.owner_user_id == player.get_user_id() continue;
        if target.health <= 0 continue;

        target_pos := target.entity.world_position;
        to_target := v2{target_pos.x - origin.x, target_pos.y - origin.y};

        // Project onto beam direction
        dot := to_target.x * dir.x + to_target.y * dir.y;
        if dot < 0 || dot > range continue;

        // Perpendicular distance
        proj := v2{dir.x * dot, dir.y * dot};
        perp := v2{to_target.x - proj.x, to_target.y - proj.y};
        perp_dist := length(perp);

        if perp_dist <= width {
            weapon_target_apply_damage(target, damage, player.get_user_id());
            weapon_spawn_impact_particles(target.entity.world_position, wt, direction);
        }
    }
}

// Cone beam: damage targets within a cone from origin
beam_cone_damage :: proc(player: Player, origin: v2, direction: v2, range: float, cone_angle_deg: float, damage: float, wt: Weapon_Type) {
    nearby: [..]Weapon_Target;
    Scene.get_all_components_in_range(origin, range, ref nearby);

    dir := normalize(direction);
    half_angle := cone_angle_deg * 0.5 * 3.14159 / 180.0;

    for target: nearby {
        if target.owner_user_id == player.get_user_id() continue;
        if target.health <= 0 continue;

        target_pos := target.entity.world_position;
        to_target := v2{target_pos.x - origin.x, target_pos.y - origin.y};
        dist := length(to_target);
        if dist < 0.1 || dist > range continue;

        to_target_norm := normalize(to_target);

        dot := dir.x * to_target_norm.x + dir.y * to_target_norm.y;
        if dot > 1.0 { dot = 1.0; }
        if dot < -1.0 { dot = -1.0; }

        cos_half := cos(half_angle);

        if dot >= cos_half {
            weapon_target_apply_damage(target, damage, player.get_user_id());
            weapon_spawn_impact_particles(target.entity.world_position, wt, direction);
        }
    }
}

// Radius-based damage: damages all targets within range (Octo Siphoner)
beam_radius_damage :: proc(player: Player, origin: v2, range: float, damage: float, wt: Weapon_Type) -> s64 {
    nearby: [..]Weapon_Target;
    Scene.get_all_components_in_range(origin, range, ref nearby);
    hit_count: s64 = 0;
    for target: nearby {
        if target.owner_user_id == player.get_user_id() continue;
        if target.health <= 0 continue;
        weapon_target_apply_damage(target, damage, player.get_user_id());
        hit_direction := target.entity.world_position - origin;
        weapon_spawn_impact_particles(target.entity.world_position, wt, hit_direction);
        hit_count += 1;
    }
    return hit_count;
}

// Beam visual entity - positions spine beam between source and target each frame
Beam_Visual :: class : Component {
    owner_user_id: string;
    target_id: u64;
    beam_range: float;
    direction_offset_degrees: float;

    ao_update :: method(dt: float) {
        spine_anim := entity.get_component(Spine_Animator);
        if spine_anim == null return;

        // Find source player
        source: Player;
        for p: component_iterator(Player) {
            if p.get_user_id() == owner_user_id {
                source = p;
                break;
            }
        }
        if source == null {
            entity.destroy();
            return;
        }

        aim_dir := source.last_aim_direction;
        start_pos := get_projectile_spawn_pos(source, aim_dir);

        end_pos: v2;
        if target_id != 0 {
            // Targeted beam (Octo Siphoner) - aim at specific target
            target: Weapon_Target;
            for wt: component_iterator(Weapon_Target) {
                if wt.entity.id == target_id {
                    target = wt;
                    break;
                }
            }
            if target == null || target.health <= 0 {
                entity.destroy();
                return;
            }
            end_pos = target.entity.world_position;
        } else {
            // Directional beam follows the player's aim. Solar Siphoner uses
            // offset copies to show the edges of its damage cone.
            aim_dir := source.last_aim_direction;
            angle := direction_offset_degrees * 3.14159 / 180.0;
            dir := v2{
                aim_dir.x * cos(angle) - aim_dir.y * sin(angle),
                aim_dir.x * sin(angle) + aim_dir.y * cos(angle),
            };
            end_pos = v2{start_pos.x + dir.x * beam_range, start_pos.y + dir.y * beam_range};
        }

        // Anchor the entity at the muzzle so its continuous particles follow
        // the weapon. Beam bones then use offsets in that local space.
        entity.set_local_position(start_pos);
        spine_anim.set_bone_local_position("beam_base", {});
        spine_anim.set_bone_local_position("AIM", end_pos - start_pos);
    }
}

spawn_beam_entity :: proc(player: Player, target_id: u64, skin_name: string, anim_name: string, beam_range: float, wt: Weapon_Type, direction_offset_degrees: float = 0.0, with_particles: bool = true) {
    beam_entity := Scene.create_entity();
    initial_direction := weapon_particle_direction(player.last_aim_direction);
    beam_entity.set_local_position(get_projectile_spawn_pos(player, initial_direction));

    spine := beam_entity.add_component(Spine_Animator);
    beam_asset := get_asset(Spine_Asset, "reusable_weapons/anims/reusable-weapons/lightning_beam/lighting_beam.spine");
    spine.set_skeleton(beam_asset);
    spine.disable_all_skins();
    spine.enable_skin(skin_name);
    spine.refresh_skins();
    spine.set_animation(anim_name, true, 0);

    beam := beam_entity.add_component(Beam_Visual);
    beam.owner_user_id = player.get_user_id();
    beam.target_id = target_id;
    beam.beam_range = beam_range;
    beam.direction_offset_degrees = direction_offset_degrees;

    if with_particles {
        weapon_attach_beam_particles(beam_entity, wt);
    }
}

destroy_player_beams :: proc(owner_user_id: string) {
    for beam: component_iterator(Beam_Visual) {
        if beam.owner_user_id == owner_user_id {
            beam.entity.destroy();
        }
    }
}
