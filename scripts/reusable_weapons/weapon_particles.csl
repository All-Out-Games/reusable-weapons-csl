// Deterministic particle vocabulary shared by every reusable weapon.
// Bursts live on short-lived VFX entities; continuous systems live and die
// with the projectile, beam, or area entity that owns them.

WEAPON_PARTICLE_LAYER :: 0;

weapon_particle_circle :: proc() -> Texture_Asset {
    return get_asset(Texture_Asset, "$AO/circle.png");
}

weapon_particle_streak :: proc() -> Texture_Asset {
    return get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/projectiles/MachineGunBullet.png");
}

weapon_particle_water :: proc() -> Texture_Asset {
    return get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/projectiles/WaterBullet.png");
}

weapon_particle_direction :: proc(direction: v2) -> v2 {
    if length_squared(direction) <= 0.0001 {
        return {1, 0};
    }
    return normalize(direction);
}

weapon_particle_opposite_direction :: proc(direction: v2) -> v2 {
    dir := weapon_particle_direction(direction);
    return {-dir.x, -dir.y};
}

weapon_particle_energy_colors :: proc(wt: Weapon_Type) -> (v4, v4) {
    switch wt {
        case .RAY_GUN:          { return {1.0, 0.25, 0.95, 1.0}, {0.25, 0.05, 1.0, 0.0}; }
        case .PLASMA_BURST:     { return {0.95, 0.35, 1.0, 1.0}, {0.2, 0.02, 0.7, 0.0}; }
        case .BEAM_MACHINE:     { return {0.25, 1.0, 1.0, 1.0}, {0.05, 0.25, 1.0, 0.0}; }
        case .FIRE_RAY:         { return {1.0, 0.95, 0.25, 1.0}, {1.0, 0.08, 0.01, 0.0}; }
        case .ICE_LAUNCHER:     { return {0.85, 1.0, 1.0, 1.0}, {0.05, 0.35, 1.0, 0.0}; }
        case .GLACIATOR:        { return {0.55, 1.0, 1.0, 1.0}, {0.1, 0.15, 1.0, 0.0}; }
        case .SOLAR_SIPHONER:   { return {1.0, 0.95, 0.35, 1.0}, {1.0, 0.15, 0.55, 0.0}; }
        case .OCTO_SIPHONER:    { return {1.0, 0.35, 0.85, 1.0}, {0.25, 0.05, 0.65, 0.0}; }
        case .VOID_SPLITTER:    { return {0.45, 0.9, 1.0, 1.0}, {0.15, 0.01, 0.45, 0.0}; }
        case .MEGA_BLADE:       { return {0.75, 1.0, 1.0, 1.0}, {0.05, 0.45, 1.0, 0.0}; }
        case .BUZZSHOT:         { return {1.0, 0.85, 0.2, 1.0}, {1.0, 0.1, 0.01, 0.0}; }
        default:                { return {1.0, 0.9, 0.35, 1.0}, {1.0, 0.2, 0.02, 0.0}; }
    }
}

spawn_weapon_particle_burst :: proc(pos: v2, desc: Particle_System_Desc, z_offset: float = 0.2) -> Entity {
    burst_entity := Scene.create_entity();
    burst_entity.set_local_position(pos);

    particles := burst_entity.add_component(Particle_System_Component);
    particles.layer = WEAPON_PARTICLE_LAYER;
    particles.z_offset = z_offset;
    particles.play(desc);

    cleanup := burst_entity.add_component(Simple_VFX);
    cleanup.lifetime = desc.lifetime.max + 0.1;
    return burst_entity;
}

attach_weapon_particle_system :: proc(owner: Entity, desc: Particle_System_Desc, z_offset: float = 0.15) -> Particle_System_Component {
    particles := owner.add_component(Particle_System_Component);
    particles.layer = WEAPON_PARTICLE_LAYER;
    particles.z_offset = z_offset;
    particles.play(desc);
    return particles;
}

weapon_spawn_energy_burst :: proc(pos: v2, start_color: v4, end_color: v4, count: int, scale: float) {
    desc := Particle_System_Desc.preset_explosion();
    desc.seed_salt = 401;
    desc.emission = Particle_Emission.burst(count);
    desc.color_over_lifetime = Particle_System_Desc.over_lifetime_v4(start_color, end_color);
    desc.speed = Particle_System_Desc.range_float(1.5 * scale, 5.5 * scale);
    desc.lifetime = Particle_System_Desc.range_float(0.2, 0.55);
    desc.fade_out_seconds = 0.22;
    desc.sprite = weapon_particle_circle();
    desc.size_over_lifetime = Particle_System_Desc.over_lifetime_v2(
        {0.22 * scale, 0.22 * scale},
        {0.015, 0.015},
    );
    spawn_weapon_particle_burst(pos, desc, 0.3);
}

weapon_spawn_smoke_burst :: proc(pos: v2, count: int, scale: float, color: v4) {
    smoke := Particle_System_Desc.preset_smoke();
    smoke.seed_salt = 809;
    smoke.emission = Particle_Emission.burst(count);
    smoke.prewarm = false;
    smoke.auto_disable_when_finished = true;
    smoke.simulation_space = .WORLD;
    smoke.spawn_position_radius = 0.12 * scale;
    smoke.color_over_lifetime = Particle_System_Desc.over_lifetime_v4(color, {0.05, 0.04, 0.07, 0.0});
    smoke.direction = {0, 1};
    smoke.direction_spread_degrees = 95;
    smoke.speed = Particle_System_Desc.range_float(0.35, 1.25 * scale);
    smoke.lifetime = Particle_System_Desc.range_float(0.55, 1.15);
    smoke.fade_in_seconds = 0.08;
    smoke.fade_out_seconds = 0.5;
    smoke.sprite = weapon_particle_circle();
    smoke.size_over_lifetime = Particle_System_Desc.over_lifetime_v2(
        {0.16 * scale, 0.16 * scale},
        {0.7 * scale, 0.7 * scale},
    );
    spawn_weapon_particle_burst(pos, smoke, -0.1);
}

weapon_spawn_explosion_particles :: proc(pos: v2, start_color: v4, end_color: v4, scale: float, smoke_count: int) {
    core := Particle_System_Desc.preset_explosion();
    core.seed_salt = 1103;
    core.emission = Particle_Emission.burst((36.0 * scale).(int));
    core.spawn_position_radius = 0.12 * scale;
    core.color_over_lifetime = Particle_System_Desc.over_lifetime_v4(start_color, end_color);
    core.speed = Particle_System_Desc.range_float(2.0 * scale, 7.5 * scale);
    core.lifetime = Particle_System_Desc.range_float(0.22, 0.62);
    core.sprite = weapon_particle_circle();
    core.size_over_lifetime = Particle_System_Desc.over_lifetime_v2(
        {0.38 * scale, 0.38 * scale},
        {0.02, 0.02},
    );
    spawn_weapon_particle_burst(pos, core, 0.32);

    sparks := Particle_System_Desc.preset_sparks();
    sparks.seed_salt = 1229;
    sparks.emission = Particle_Emission.burst((22.0 * scale).(int));
    sparks.direction = {1, 0};
    sparks.direction_spread_degrees = 360;
    sparks.color_over_lifetime = Particle_System_Desc.over_lifetime_v4(start_color, end_color);
    sparks.speed = Particle_System_Desc.range_float(4.0 * scale, 10.0 * scale);
    sparks.lifetime = Particle_System_Desc.range_float(0.28, 0.8);
    sparks.size_over_lifetime = Particle_System_Desc.over_lifetime_v2(
        {0.28 * scale, 0.045 * scale},
        {0.03, 0.006},
    );
    spawn_weapon_particle_burst(pos, sparks, 0.35);

    if smoke_count > 0 {
        weapon_spawn_smoke_burst(pos, smoke_count, scale, {0.32, 0.25, 0.3, 0.72});
    }
}

weapon_spawn_muzzle_particles :: proc(player: Player, wt: Weapon_Type, direction: v2, use_offhand: bool = false) {
    dir := weapon_particle_direction(direction);
    pos := get_projectile_spawn_pos(player, dir, use_offhand);

    switch wt {
        case .ASSAULT_RIFLE, .SUBMACHINE_GUN, .GATLING_GUN, .AKIMBO_PISTOLS: {
            flash := Particle_System_Desc.preset_shotgun();
            flash.seed_salt = 101 + wt.(u64);
            flash.emission = Particle_Emission.burst(wt == .GATLING_GUN ? 5 : 8);
            flash.direction = dir;
            flash.direction_spread_degrees = 14;
            flash.speed = Particle_System_Desc.range_float(4.5, 9.0);
            flash.lifetime = Particle_System_Desc.range_float(0.08, 0.18);
            flash.color_over_lifetime = Particle_System_Desc.over_lifetime_v4(
                {1.0, 0.98, 0.65, 1.0},
                {1.0, 0.18, 0.01, 0.0},
            );
            flash.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.24, 0.055}, {0.03, 0.008});
            spawn_weapon_particle_burst(pos, flash, 0.35);
        }
        case .BLUNDERBUSS, .EXPLOSIVE_SHOTGUN, .SUNNY_SIDE_SHOTTY: {
            flash := Particle_System_Desc.preset_shotgun();
            flash.seed_salt = 211 + wt.(u64);
            flash.emission = Particle_Emission.burst(wt == .BLUNDERBUSS ? 24 : 18);
            flash.direction = dir;
            flash.direction_spread_degrees = wt == .BLUNDERBUSS ? 28 : 20;
            flash.speed = Particle_System_Desc.range_float(5.0, 12.0);
            flash.lifetime = Particle_System_Desc.range_float(0.1, 0.28);
            if wt == .SUNNY_SIDE_SHOTTY {
                flash.color_over_lifetime = Particle_System_Desc.over_lifetime_v4({1.0, 1.0, 0.55, 1.0}, {1.0, 0.42, 0.02, 0.0});
            }
            spawn_weapon_particle_burst(pos, flash, 0.35);
            weapon_spawn_smoke_burst(pos, 5, 0.7, {0.45, 0.4, 0.38, 0.55});
        }
        case .WATER_GUN, .WATER_BALLOON_RPG, .HYDRO_CANNON: {
            splash := Particle_System_Desc.preset_fountain();
            splash.seed_salt = 307 + wt.(u64);
            splash.emission = Particle_Emission.burst(wt == .HYDRO_CANNON ? 22 : 12);
            splash.prewarm = false;
            splash.auto_disable_when_finished = true;
            splash.simulation_space = .WORLD;
            splash.direction = dir;
            splash.direction_spread_degrees = 24;
            splash.speed = Particle_System_Desc.range_float(2.5, 7.0);
            splash.lifetime = Particle_System_Desc.range_float(0.18, 0.5);
            splash.gravity = {0, -4};
            splash.sprite = weapon_particle_circle();
            splash.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.13, 0.13}, {0.025, 0.025});
            spawn_weapon_particle_burst(pos, splash, 0.28);
        }
        case .MISSILE_BARRAGE, .GOLDEN_ROCKET_LAUNCHER, .BOOMWHEEL, .POISON_GRENADE: {
            ignition := Particle_System_Desc.preset_shotgun();
            ignition.seed_salt = 419 + wt.(u64);
            ignition.emission = Particle_Emission.burst(wt == .GOLDEN_ROCKET_LAUNCHER || wt == .BOOMWHEEL ? 20 : 12);
            ignition.direction = weapon_particle_opposite_direction(dir);
            ignition.direction_spread_degrees = 34;
            ignition.speed = Particle_System_Desc.range_float(2.5, 6.0);
            ignition.lifetime = Particle_System_Desc.range_float(0.15, 0.38);
            if wt == .POISON_GRENADE {
                ignition.color_over_lifetime = Particle_System_Desc.over_lifetime_v4({0.75, 1.0, 0.2, 1.0}, {0.05, 0.4, 0.02, 0.0});
            }
            spawn_weapon_particle_burst(pos, ignition, 0.3);
        }
        case .MEGA_BLADE, .BUZZSHOT: {
            start_color, end_color := weapon_particle_energy_colors(wt);
            slash := Particle_System_Desc.preset_sparks();
            slash.seed_salt = 521 + wt.(u64);
            slash.emission = Particle_Emission.burst(20);
            slash.direction = dir;
            slash.direction_spread_degrees = 38;
            slash.color_over_lifetime = Particle_System_Desc.over_lifetime_v4(start_color, end_color);
            slash.speed = Particle_System_Desc.range_float(3.0, 8.0);
            slash.gravity = {};
            spawn_weapon_particle_burst(pos, slash, 0.35);
        }
        case .WIND_BLASTER, .STORMS_EYE: {
            wind := Particle_System_Desc.preset_dust();
            wind.seed_salt = 631 + wt.(u64);
            wind.emission = Particle_Emission.burst(28);
            wind.direction = dir;
            wind.direction_spread_degrees = wt == .WIND_BLASTER ? 52 : 360;
            wind.color_over_lifetime = Particle_System_Desc.over_lifetime_v4({0.85, 1.0, 1.0, 0.9}, {0.15, 0.75, 1.0, 0.0});
            wind.speed = Particle_System_Desc.range_float(1.0, 4.5);
            wind.gravity = {0, 0.35};
            wind.sprite = weapon_particle_circle();
            wind.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.12, 0.12}, {0.42, 0.42});
            spawn_weapon_particle_burst(pos, wind, 0.18);
        }
        default: {
            start_color, end_color := weapon_particle_energy_colors(wt);
            pulse := Particle_System_Desc.preset_shotgun();
            pulse.seed_salt = 743 + wt.(u64);
            pulse.emission = Particle_Emission.burst(14);
            pulse.direction = dir;
            pulse.direction_spread_degrees = 20;
            pulse.color_over_lifetime = Particle_System_Desc.over_lifetime_v4(start_color, end_color);
            pulse.speed = Particle_System_Desc.range_float(2.0, 7.0);
            pulse.lifetime = Particle_System_Desc.range_float(0.12, 0.35);
            pulse.sprite = weapon_particle_streak();
            pulse.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.32, 0.065}, {0.035, 0.01});
            spawn_weapon_particle_burst(pos, pulse, 0.35);
        }
    }
}

weapon_spawn_impact_particles :: proc(pos: v2, wt: Weapon_Type, incoming_direction: v2) {
    reverse_dir := weapon_particle_opposite_direction(incoming_direction);

    switch wt {
        case .ASSAULT_RIFLE, .SUBMACHINE_GUN, .GATLING_GUN, .AKIMBO_PISTOLS, .BLUNDERBUSS: {
            sparks := Particle_System_Desc.preset_sparks();
            sparks.seed_salt = 907 + wt.(u64);
            sparks.emission = Particle_Emission.burst(wt == .BLUNDERBUSS ? 18 : 9);
            sparks.direction = reverse_dir;
            sparks.direction_spread_degrees = 125;
            sparks.speed = Particle_System_Desc.range_float(2.5, 7.5);
            sparks.lifetime = Particle_System_Desc.range_float(0.16, 0.48);
            spawn_weapon_particle_burst(pos, sparks, 0.35);
        }
        case .EXPLOSIVE_SHOTGUN, .SUNNY_SIDE_SHOTTY: {
            start_color := v4{1.0, 0.95, 0.35, 1.0};
            end_color := v4{1.0, 0.08, 0.01, 0.0};
            if wt == .SUNNY_SIDE_SHOTTY {
                start_color = {1.0, 1.0, 0.65, 1.0};
                end_color = {1.0, 0.35, 0.01, 0.0};
            }
            weapon_spawn_explosion_particles(pos, start_color, end_color, 0.55, 2);
        }
        case .MISSILE_BARRAGE: {
            weapon_spawn_explosion_particles(pos, {1.0, 0.95, 0.35, 1.0}, {1.0, 0.06, 0.01, 0.0}, 0.85, 6);
        }
        case .GOLDEN_ROCKET_LAUNCHER: {
            weapon_spawn_explosion_particles(pos, {1.0, 1.0, 0.65, 1.0}, {1.0, 0.2, 0.01, 0.0}, 1.65, 14);
        }
        case .BOOMWHEEL: {
            weapon_spawn_explosion_particles(pos, {1.0, 0.85, 0.3, 1.0}, {0.75, 0.02, 0.01, 0.0}, 1.35, 12);
        }
        case .WATER_GUN, .WATER_BALLOON_RPG, .HYDRO_CANNON: {
            water := Particle_System_Desc.preset_fountain();
            water.seed_salt = 1013 + wt.(u64);
            water.emission = Particle_Emission.burst(wt == .WATER_BALLOON_RPG ? 42 : 18);
            water.prewarm = false;
            water.auto_disable_when_finished = true;
            water.simulation_space = .WORLD;
            water.direction = {0, 1};
            water.direction_spread_degrees = wt == .WATER_BALLOON_RPG ? 150 : 105;
            water.speed = Particle_System_Desc.range_float(2.0, wt == .WATER_BALLOON_RPG ? 8.0 : 5.5);
            water.lifetime = Particle_System_Desc.range_float(0.35, 0.9);
            water.gravity = {0, -9.8};
            water.sprite = weapon_particle_circle();
            water.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.16, 0.16}, {0.035, 0.035});
            spawn_weapon_particle_burst(pos, water, 0.3);
        }
        case .MEGA_BLADE, .BUZZSHOT: {
            start_color, end_color := weapon_particle_energy_colors(wt);
            sparks := Particle_System_Desc.preset_sparks();
            sparks.seed_salt = 1123 + wt.(u64);
            sparks.emission = Particle_Emission.burst(24);
            sparks.direction = reverse_dir;
            sparks.direction_spread_degrees = 155;
            sparks.color_over_lifetime = Particle_System_Desc.over_lifetime_v4(start_color, end_color);
            sparks.speed = Particle_System_Desc.range_float(3.0, 9.0);
            sparks.gravity = {0, -5};
            spawn_weapon_particle_burst(pos, sparks, 0.38);
        }
        case .POISON_GRENADE: {
            weapon_spawn_energy_burst(pos, {0.75, 1.0, 0.2, 0.9}, {0.03, 0.45, 0.02, 0.0}, 36, 0.9);
            weapon_spawn_smoke_burst(pos, 12, 1.1, {0.25, 0.65, 0.08, 0.7});
        }
        case .WIND_BLASTER, .STORMS_EYE: {
            wind := Particle_System_Desc.preset_dust();
            wind.seed_salt = 1223 + wt.(u64);
            wind.emission = Particle_Emission.burst(30);
            wind.direction = {1, 0};
            wind.direction_spread_degrees = 360;
            wind.color_over_lifetime = Particle_System_Desc.over_lifetime_v4({0.85, 1.0, 1.0, 0.8}, {0.15, 0.65, 1.0, 0.0});
            wind.speed = Particle_System_Desc.range_float(0.8, 4.0);
            wind.gravity = {0, 0.25};
            wind.sprite = weapon_particle_circle();
            spawn_weapon_particle_burst(pos, wind, 0.15);
        }
        default: {
            start_color, end_color := weapon_particle_energy_colors(wt);
            weapon_spawn_energy_burst(pos, start_color, end_color, 24, 0.8);
        }
    }
}

weapon_attach_projectile_particles :: proc(projectile: Entity, wt: Weapon_Type, direction: v2) {
    desc: Particle_System_Desc;
    dir := weapon_particle_direction(direction);
    reverse_dir := weapon_particle_opposite_direction(dir);

    switch wt {
        case .ASSAULT_RIFLE, .SUBMACHINE_GUN, .GATLING_GUN, .AKIMBO_PISTOLS: {
            desc = Particle_System_Desc.preset_default();
            desc.emission = Particle_Emission.continuous(18);
            desc.color_over_lifetime = Particle_System_Desc.over_lifetime_v4({1.0, 0.75, 0.2, 0.8}, {1.0, 0.12, 0.01, 0.0});
            desc.direction = reverse_dir;
            desc.direction_spread_degrees = 18;
            desc.speed = Particle_System_Desc.range_float(0.15, 0.65);
            desc.lifetime = Particle_System_Desc.range_float(0.08, 0.18);
            desc.sprite = weapon_particle_circle();
            desc.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.075, 0.075}, {});
        }
        case .BLUNDERBUSS, .MISSILE_BARRAGE, .GOLDEN_ROCKET_LAUNCHER, .BOOMWHEEL: {
            desc = Particle_System_Desc.preset_smoke();
            desc.emission = Particle_Emission.continuous(wt == .MISSILE_BARRAGE ? 16 : 10);
            desc.spawn_position_radius = 0.06;
            desc.color_over_lifetime = Particle_System_Desc.over_lifetime_v4({0.38, 0.34, 0.34, 0.65}, {0.08, 0.06, 0.08, 0.0});
            desc.direction = reverse_dir;
            desc.direction_spread_degrees = 28;
            desc.speed = Particle_System_Desc.range_float(0.2, 0.9);
            desc.lifetime = Particle_System_Desc.range_float(0.35, 0.8);
            desc.fade_in_seconds = 0.05;
            desc.fade_out_seconds = 0.35;
            desc.sprite = weapon_particle_circle();
            desc.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.1, 0.1}, {0.38, 0.38});
        }
        case .EXPLOSIVE_SHOTGUN, .SUNNY_SIDE_SHOTTY: {
            desc = Particle_System_Desc.preset_embers();
            desc.emission = Particle_Emission.continuous(14);
            desc.spawn_position_radius = 0.04;
            desc.direction = reverse_dir;
            desc.direction_spread_degrees = 35;
            desc.speed = Particle_System_Desc.range_float(0.5, 1.4);
            desc.lifetime = Particle_System_Desc.range_float(0.18, 0.4);
            desc.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.08, 0.08}, {});
        }
        case .WATER_GUN, .WATER_BALLOON_RPG, .HYDRO_CANNON: {
            desc = Particle_System_Desc.preset_default();
            desc.emission = Particle_Emission.continuous(24);
            desc.color_over_lifetime = Particle_System_Desc.over_lifetime_v4({0.75, 1.0, 1.0, 0.9}, {0.05, 0.35, 1.0, 0.0});
            desc.direction = reverse_dir;
            desc.direction_spread_degrees = 35;
            desc.speed = Particle_System_Desc.range_float(0.2, 1.0);
            desc.lifetime = Particle_System_Desc.range_float(0.22, 0.5);
            desc.gravity = {0, -2.5};
            desc.sprite = weapon_particle_circle();
            desc.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.11, 0.11}, {0.025, 0.025});
        }
        case .POISON_GRENADE: {
            desc = Particle_System_Desc.preset_magic_aura();
            desc.emission = Particle_Emission.continuous(12);
            desc.spawn_position_radius = 0.18;
            desc.color_over_lifetime = Particle_System_Desc.over_lifetime_v4({0.8, 1.0, 0.2, 0.8}, {0.04, 0.4, 0.01, 0.0});
            desc.lifetime = Particle_System_Desc.range_float(0.35, 0.8);
            desc.sprite = weapon_particle_circle();
        }
        case .MEGA_BLADE, .BUZZSHOT: {
            start_color, end_color := weapon_particle_energy_colors(wt);
            desc = Particle_System_Desc.preset_sparks();
            desc.emission = Particle_Emission.continuous(22);
            desc.color_over_lifetime = Particle_System_Desc.over_lifetime_v4(start_color, end_color);
            desc.direction = reverse_dir;
            desc.direction_spread_degrees = 32;
            desc.speed = Particle_System_Desc.range_float(0.8, 2.2);
            desc.lifetime = Particle_System_Desc.range_float(0.15, 0.38);
            desc.gravity = {};
            desc.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.18, 0.03}, {0.025, 0.006});
        }
        default: {
            start_color, end_color := weapon_particle_energy_colors(wt);
            desc = Particle_System_Desc.preset_magic_aura();
            desc.emission = Particle_Emission.continuous(28);
            desc.spawn_position_radius = 0.1;
            desc.color_over_lifetime = Particle_System_Desc.over_lifetime_v4(start_color, end_color);
            desc.speed = Particle_System_Desc.range_float(0.05, 0.45);
            desc.lifetime = Particle_System_Desc.range_float(0.24, 0.55);
            desc.sprite = weapon_particle_circle();
            desc.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.13, 0.13}, {});
        }
    }

    desc.seed_salt += 2003 + wt.(u64);
    desc.simulation_space = .WORLD;
    desc.prewarm = false;
    desc.auto_disable_when_finished = false;
    attach_weapon_particle_system(projectile, desc, 0.18);
}

weapon_attach_beam_particles :: proc(beam_entity: Entity, wt: Weapon_Type) {
    start_color, end_color := weapon_particle_energy_colors(wt);
    desc := Particle_System_Desc.preset_magic_aura();
    desc.seed_salt = 3001 + wt.(u64);
    desc.emission = Particle_Emission.continuous(22);
    desc.simulation_space = .LOCAL;
    desc.spawn_position_radius = 0.22;
    desc.color_over_lifetime = Particle_System_Desc.over_lifetime_v4(start_color, end_color);
    desc.direction = {1, 0};
    desc.direction_spread_degrees = 360;
    desc.speed = Particle_System_Desc.range_float(0.15, 0.85);
    desc.lifetime = Particle_System_Desc.range_float(0.35, 0.8);
    desc.sprite = weapon_particle_circle();
    desc.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.16, 0.16}, {});
    attach_weapon_particle_system(beam_entity, desc, 0.3);
}

weapon_attach_poison_cloud_particles :: proc(cloud_entity: Entity) {
    desc := Particle_System_Desc.preset_magic_aura();
    desc.seed_salt = 4001;
    desc.emission = Particle_Emission.continuous(18);
    desc.simulation_space = .LOCAL;
    desc.spawn_position_radius = 1.25;
    desc.color_over_lifetime = Particle_System_Desc.over_lifetime_v4({0.68, 1.0, 0.15, 0.62}, {0.03, 0.28, 0.02, 0.0});
    desc.direction = {0, 1};
    desc.direction_spread_degrees = 75;
    desc.speed = Particle_System_Desc.range_float(0.08, 0.55);
    desc.lifetime = Particle_System_Desc.range_float(1.2, 2.5);
    desc.sprite = weapon_particle_circle();
    desc.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.16, 0.16}, {0.52, 0.52});
    attach_weapon_particle_system(cloud_entity, desc, -0.05);
}

weapon_attach_tornado_particles :: proc(tornado_entity: Entity, storms_eye: bool) {
    desc := Particle_System_Desc.preset_dust();
    desc.seed_salt = storms_eye ? 5009 : 5003;
    desc.emission = Particle_Emission.continuous(storms_eye ? 34 : 26);
    desc.simulation_space = storms_eye ? .WORLD : .LOCAL;
    desc.spawn_position_radius = storms_eye ? 1.15 : 0.75;
    desc.color_over_lifetime = Particle_System_Desc.over_lifetime_v4({0.9, 1.0, 1.0, 0.72}, {0.08, 0.55, 1.0, 0.0});
    desc.direction = {1, 0};
    desc.direction_spread_degrees = 360;
    desc.speed = Particle_System_Desc.range_float(0.4, storms_eye ? 2.8 : 1.8);
    desc.lifetime = Particle_System_Desc.range_float(0.55, 1.25);
    desc.gravity = {0, 0.4};
    desc.sprite = weapon_particle_circle();
    desc.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.09, 0.09}, {0.34, 0.34});
    attach_weapon_particle_system(tornado_entity, desc, 0.1);
}

weapon_spawn_geyser_particles :: proc(pos: v2) {
    spray := Particle_System_Desc.preset_fountain();
    spray.seed_salt = 6007;
    spray.emission = Particle_Emission.burst(34);
    spray.prewarm = false;
    spray.auto_disable_when_finished = true;
    spray.simulation_space = .WORLD;
    spray.direction = {0, 1};
    spray.direction_spread_degrees = 42;
    spray.speed = Particle_System_Desc.range_float(4.0, 8.5);
    spray.lifetime = Particle_System_Desc.range_float(0.55, 1.1);
    spray.gravity = {0, -10};
    spray.sprite = weapon_particle_circle();
    spray.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.16, 0.16}, {0.035, 0.035});
    spawn_weapon_particle_burst(pos, spray, 0.3);

    mist := Particle_System_Desc.preset_smoke();
    mist.seed_salt = 6011;
    mist.emission = Particle_Emission.burst(10);
    mist.prewarm = false;
    mist.auto_disable_when_finished = true;
    mist.color_over_lifetime = Particle_System_Desc.over_lifetime_v4({0.75, 0.95, 1.0, 0.45}, {0.25, 0.65, 1.0, 0.0});
    mist.direction_spread_degrees = 110;
    mist.speed = Particle_System_Desc.range_float(0.4, 1.5);
    mist.lifetime = Particle_System_Desc.range_float(0.5, 1.0);
    mist.sprite = weapon_particle_circle();
    mist.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.18, 0.18}, {0.7, 0.7});
    spawn_weapon_particle_burst(pos, mist, -0.05);
}

weapon_spawn_melee_particles :: proc(player: Player) {
    dir := weapon_particle_direction(player.last_aim_direction);
    pos := player.entity.world_position + dir * 0.8 + v2{0, 0.2};

    slash := Particle_System_Desc.preset_sparks();
    slash.seed_salt = 7001;
    slash.emission = Particle_Emission.burst(26);
    slash.direction = dir;
    slash.direction_spread_degrees = 95;
    slash.color_over_lifetime = Particle_System_Desc.over_lifetime_v4({0.9, 1.0, 1.0, 1.0}, {0.15, 0.55, 1.0, 0.0});
    slash.speed = Particle_System_Desc.range_float(2.5, 8.0);
    slash.lifetime = Particle_System_Desc.range_float(0.18, 0.5);
    slash.gravity = {0, -2};
    slash.size_over_lifetime = Particle_System_Desc.over_lifetime_v2({0.24, 0.035}, {0.025, 0.006});
    spawn_weapon_particle_burst(pos, slash, 0.4);
}
